<Window
    x:Class="TarkovLootScanner.UI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TarkovLootScanner.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Overlay"
    AllowsTransparency="True"
    Background="{DynamicResource OverlayBackgroundBrush}"
    MouseDown="OverlayWindow_MouseDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Border Padding="12"
            Background="Transparent">
        <StackPanel VerticalAlignment="Center"
                    Orientation="Vertical">
            <!--  Scanning block  -->
            <TextBlock
                x:Name="ScanningText"
                FontSize="16"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Scanning..."
                Visibility="Collapsed"/>

            <!--  Results block  -->
            <StackPanel
                x:Name="ResultsBlock"
                Orientation="Vertical"
                Visibility="Visible">
                <Grid x:Name="ResultsTitle">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            x:Name="TitleText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Salewa (3 Slots)"/>

                        <TextBlock
                            x:Name="UpdatedText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Updated 1 hour ago"/>
                    </StackPanel>

                    <Image
                        x:Name="ItemImage"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Source="/Assets/Placeholder.png"/>
                </Grid>

                <Separator Height="1"
                           Margin="-12,12,-12,6"/>

                <StackPanel x:Name="ResultsProfit"
                            Orientation="Vertical">
                    <Grid Margin="0,0,0,0"
                          Visibility="Visible">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="ProfitText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Profit Flea vs Trader"/>

                        <TextBlock
                            x:Name="ProfitResultText"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="64,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="14.420₽ (4.806₽)"/>
                    </Grid>
                </StackPanel>

                <Separator Height="1"
                           Margin="-12,8,-12,6"/>

                <StackPanel x:Name="ResultsPrice"
                            Orientation="Vertical">
                    <Grid Margin="0,0,0,8"
                          Visibility="Visible">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="PriceText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Price"/>

                        <TextBlock
                            x:Name="PriceResultText"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="64,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="23.420₽ (11.710₽)"/>
                    </Grid>

                    <Grid Margin="0,0,0,0"
                          Visibility="Visible">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="LowAvg24HText"
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Low Avg24H Price"/>

                        <TextBlock
                            x:Name="LowAvg24HResultText"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="64,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="20 555₽ (10.277₽)"/>
                    </Grid>
                </StackPanel>

                <Separator Height="1"
                           Margin="-12,8,-12,8"/>

                <StackPanel x:Name="ResultsTrader"
                            Orientation="Vertical">
                    <Grid Margin="0,0,0,0"
                          Visibility="Visible">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="TraderImage"
                               Grid.Column="0"
                               Width="32"
                               Height="32"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Source="/Assets/Placeholder.png"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="16,16"
                                                 RadiusX="16"
                                                 RadiusY="16"/>
                            </Image.Clip>
                        </Image>

                        <TextBlock
                            x:Name="TraderPriceText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Therapist"/>

                        <TextBlock
                            x:Name="TraderPriceResultText"
                            Grid.Column="2"
                            Margin="64,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="9.000₽ (3.000₽)"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
