<Application x:Class="TarkovLootScanner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TarkovLootScanner"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF212121"/>

        <SolidColorBrush x:Key="TitleBarButtonHoverBackgroundBrush" Color="#22000000"/>
        <SolidColorBrush x:Key="TitleBarButtonPressedBackgroundBrush" Color="#33000000"/>

        <SolidColorBrush x:Key="TitleBarCloseHoverBackgroundBrush" Color="#E81123"/>
        <SolidColorBrush x:Key="TitleBarClosePressedBackgroundBrush" Color="#C60F1A"/>

        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#55000000"/>
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White"/>
    </Application.Resources>
</Application>
